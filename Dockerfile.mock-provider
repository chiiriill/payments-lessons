FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/mock-provider ./cmd/mock-provider

FROM alpine:3.21
RUN apk --no-cache add ca-certificates tzdata
COPY --from=build /bin/mock-provider /bin/mock-provider
ENTRYPOINT ["/bin/mock-provider"]
